{
	"name": "pl_cdc_ingest_orders",
	"properties": {
		"activities": [
			{
				"name": "GetVersions",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n  (SELECT last_sync_version FROM dbo.cdc_watermark WHERE table_name='orders') AS last_sync,\n  CHANGE_TRACKING_CURRENT_VERSION() AS cur_version,\n  CHANGE_TRACKING_MIN_VALID_VERSION(OBJECT_ID('dbo.orders')) AS min_valid",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_generic",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "RetentionOK",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "GetVersions",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greaterOrEquals(activity('GetVersions').output.firstRow.last_sync, activity('GetVersions').output.firstRow.min_valid)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Watermark expired",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Watermark expired — full reload required",
								"errorCode": "ER01"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "CopyOrders",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 10,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT ct.order_id, ct.SYS_CHANGE_OPERATION AS _op,\n       ct.SYS_CHANGE_VERSION AS _change_version,\n       o.customer_unique_id, o.order_status, o.order_purchase_timestamp,\n       o.order_approved_at, o.order_delivered_carrier_date,\n       o.order_delivered_customer_date, o.order_estimated_delivery_date,\n       o.updated_at,\n       ', string(activity('GetVersions').output.firstRow.cur_version), ' AS _batch_version,\n       SYSUTCDATETIME() AS _ingest_ts\nFROM CHANGETABLE(CHANGES dbo.orders, ', string(activity('GetVersions').output.firstRow.last_sync), ') AS ct\nLEFT JOIN dbo.orders o ON o.order_id = ct.order_id\nWHERE ct.SYS_CHANGE_VERSION <= ', string(activity('GetVersions').output.firstRow.cur_version))",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_sql_generic",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze_parquet",
									"type": "DatasetReference",
									"parameters": {
										"folder": {
											"value": "@concat('orders/ingest_dt=', formatDateTime(utcnow(),'yyyy-MM-dd'))",
											"type": "Expression"
										},
										"filename": {
											"value": "@concat('orders_v', string(activity('GetVersions').output.firstRow.cur_version), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "UpdateWatermark",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CopyOrders",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[sp_update_watermark]",
								"storedProcedureParameters": {
									"new_version": {
										"value": {
											"value": "@activity('GetVersions').output.firstRow.cur_version",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"rows": {
										"value": {
											"value": "@activity('CopyOrders').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"table_name": {
										"value": "orders",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azuresql",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}